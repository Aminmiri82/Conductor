{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "component": "app",
      "include-component-in-tag": true,
      "tag-separator": "-",
      "draft": true,
      "force-tag-creation": true,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "pull-request-header": "This bot maintains the version bump and release notes automatically. Merge this PR to build a draft release; publish it only after the Mac release workflow succeeds.",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation" },
        { "type": "refactor", "section": "Maintenance" },
        { "type": "build", "section": "Build" },
        { "type": "ci", "section": "Automation" },
        { "type": "test", "section": "Testing" },
        { "type": "chore", "section": "Maintenance" }
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='conductor')].version"
        }
      ]
    }
  }
}
