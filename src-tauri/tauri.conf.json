{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conductor",
  "version": "0.1.8",
  "identifier": "com.yaramiri.conductor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "conductor",
        "width": 850,
        "height": 625,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4NEVCQUFEQ0NFQjlERTcKUldUbm5ldk1yYnBPYUwvM3kwNExVcTkzSXJ4alFWQU5mditIZ2lnRDBsdVpCRFhoTVoyYTYwUVkK",
      "endpoints": [
        "https://github.com/Aminmiri82/Conductor/releases/latest/download/latest.json"
      ]
    }
  }
}
