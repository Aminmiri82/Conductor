{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conductor Agent",
  "identifier": "com.yaramiri.conductor.agent",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Conductor Agent \u2014 isolated data",
        "width": 850,
        "height": 625,
        "dragDropEnabled": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "http://127.0.0.1:18765/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true
    }
  },
  "bundle": {
    "icon": [
      "icons/agent/128x128@2x.png",
      "icons/agent/32x32.png",
      "icons/agent/128x128.png",
      "icons/agent/icon.icns",
      "icons/agent/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
