{
  "name": "conductor",
  "private": true,
  "version": "0.1.15",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "tauri": "tauri",
    "app:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "agent:start": "bash scripts/agent/agent-app.sh start",
    "agent:stop": "bash scripts/agent/agent-app.sh stop",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p tools && tsc --noEmit -p tsconfig.node.json",
    "test": "vp test",
    "test:run": "vp test run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "bindings": "UPDATE_BINDINGS=1 cargo test --manifest-path src-tauri/Cargo.toml bindings_are_up_to_date",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:run && pnpm perf:list && cargo fmt --manifest-path src-tauri/Cargo.toml --check && pnpm lint:rust && pnpm test:rust",
    "lint": "vp lint . --deny-warnings --report-unused-disable-directives",
    "lint:fix": "pnpm lint --fix",
    "format": "vp fmt \"src/**/*.{ts,tsx,css}\" \"{scripts,tools}/**/*.ts\" \"*.{js,ts,json,html}\"",
    "format:check": "vp fmt --check \"src/**/*.{ts,tsx,css}\" \"{scripts,tools}/**/*.ts\" \"*.{js,ts,json,html}\"",
    "agent:status": "bash scripts/agent/agent-app.sh status",
    "perf:size": "pnpm build && node scripts/perf/size.ts measure",
    "perf:run": "node scripts/perf/harness.ts run",
    "perf:list": "node scripts/perf/harness.ts list",
    "perf:compare": "node scripts/perf/harness.ts compare"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.42.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.11.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@hypothesi/tauri-mcp-server": "0.13.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "packageManager": "pnpm@12.18.0"
}
